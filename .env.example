# Copy to .env and adjust as needed. Never commit .env.
# The backend loads this file from the project root at startup.

# Bind address: use 127.0.0.1 for this computer only, or 0.0.0.0 for LAN access.
HOST=127.0.0.1

# Listen port.
PORT=8080

# Login session lifetime in hours.
SESSION_HOURS=12

# Maximum request body size in bytes (25 MiB).
MAX_BODY=26214400

# ---------------------------------------------------------------------------
# MariaDB / MySQL (XAMPP)
# ---------------------------------------------------------------------------
# Start MySQL in the XAMPP Control Panel before running the server.
# These are the XAMPP defaults: root with no password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=katipunan_ams

# Optional: Google OAuth 2.0 Web client ID for Google Drive backups.
# Create one in Google Cloud Console, enable the Google Drive API, and add
# http://localhost:8080 to the authorized JavaScript origins.
GOOGLE_CLIENT_ID=
